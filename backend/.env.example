# Django
DJANGO_SECRET_KEY=your-secure-key-here-min-50-chars
DJANGO_DEBUG=False

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Redis (for Django Channels in production)
REDIS_URL=redis://redis:6379/0
USE_REDIS=True
WORKER_EMAIL_DOMAIN=sassblum.com

# Buzones corporativos cPanel UAPI (desactivado hasta validar backup/cuota/token)
CPANEL_MAILBOX_ENABLED=False
CPANEL_HOST=cpanel.example.com
CPANEL_USERNAME=your-cpanel-user
CPANEL_API_TOKEN=
# Debe sustituirse por la cuota aprobada después de revisar cPanel; 0 impide habilitarlo.
CPANEL_MAILBOX_QUOTA_MB=0
CPANEL_TIMEOUT_SECONDS=10

# CORS (comma-separated, no spaces)
CORS_ALLOWED_ORIGINS=https://app.example.com,https://www.example.com
CSRF_TRUSTED_ORIGINS=https://app.example.com,https://www.example.com

# JWT token lifetimes (seconds)
JWT_ACCESS_TOKEN_LIFETIME=3600
JWT_REFRESH_TOKEN_LIFETIME=604800

# Allowed hosts (comma-separated)
ALLOWED_HOSTS=api.example.com,www.api.example.com

# Cookie refresh: Lax cuando el frontend usa un rewrite /api first-party
AUTH_COOKIE_SAMESITE=Lax
AUTH_COOKIE_SECURE=True

# Email (production: use SMTP backend)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=notificaciones@sassblum.com
EMAIL_REPLY_TO=notificaciones@sassblum.com
EMAIL_CC=notificaciones@sassblum.com
# Datos opcionales: si quedan vacíos no se muestran en el correo.
EMAIL_SUPPORT_PHONE=+593 96 999 0990
EMAIL_SUPPORT_WHATSAPP=
EMAIL_REQUEST_ANYDESK=False
# Alternativa para Render, que puede bloquear SMTP saliente
BREVO_API_KEY=
# Base de los enlaces de verificación / reseteo enviados por email
FRONTEND_URL=https://sassblum.vercel.app

# Supabase Storage (optional)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-key
SUPABASE_STORAGE_BUCKET=sassblum

# Conexiones persistentes de Django; 0 es seguro con poolers transaccionales
CONN_MAX_AGE=0
