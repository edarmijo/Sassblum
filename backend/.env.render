DJANGO_SECRET_KEY=REPLACE_WITH_A_NEW_SECRET_KEY
DJANGO_DEBUG=False
DATABASE_URL=REPLACE_WITH_YOUR_PRODUCTION_DATABASE_URL
ALLOWED_HOSTS=sassblum.onrender.com
CORS_ALLOWED_ORIGINS=https://sassblum.vercel.app
CSRF_TRUSTED_ORIGINS=https://sassblum.vercel.app,https://sassblum.onrender.com
FRONTEND_URL=https://sassblum.vercel.app
USE_REDIS=False
AUTH_COOKIE_SAMESITE=Lax
AUTH_COOKIE_SECURE=True

# Correo oficial para notificaciones. Completa la credencial en Render,
# nunca la guardes en Git.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=notificaciones@sassblum.com
EMAIL_HOST_PASSWORD=REPLACE_IN_RENDER_WITH_EMAIL_APP_PASSWORD
DEFAULT_FROM_EMAIL=notificaciones@sassblum.com
EMAIL_CC=info@sassblum.com,soporte@sassblum.com
SASSBLUM_CONTACT_PHONE=+593-9-6999-0990,+593-9-9528-6319
SASSBLUM_CONTACT_EMAIL=soporte@sassblum.com
SASSBLUM_CONTACT_HOURS=Horario de atención de la administración

# Solo completa estas variables si vas a usar Supabase Storage en producción
# SUPABASE_STORAGE_BUCKET=SassBlumImagenes
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_KEY=REPLACE_WITH_YOUR_SUPABASE_SERVICE_KEY

# Solo necesario si activas Redis en producción
# REDIS_URL=redis://your-redis-host:6379/0
