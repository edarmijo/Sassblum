# Copy to a protected environment file outside Git and replace every placeholder.
BACKEND_IMAGE=registry.example.com/sassblum-backend:REPLACE_WITH_IMMUTABLE_TAG
FRONTEND_IMAGE=registry.example.com/sassblum-frontend:REPLACE_WITH_IMMUTABLE_TAG
DJANGO_SECRET_KEY=REPLACE_WITH_50_PLUS_RANDOM_CHARACTERS
DATABASE_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@REPLACE_HOST:5432/REPLACE_DB
CORS_ALLOWED_ORIGINS=https://app.example.com
CSRF_TRUSTED_ORIGINS=https://app.example.com
ALLOWED_HOSTS=api.example.com
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=REPLACE_USER
EMAIL_HOST_PASSWORD=REPLACE_SECRET
DEFAULT_FROM_EMAIL=noreply@example.com
FRONTEND_URL=https://app.example.com

# Optional integrations
BREVO_API_KEY=
EMAIL_CC=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=sassblum
