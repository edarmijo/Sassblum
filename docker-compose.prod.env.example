# Copy to a protected environment file outside Git and replace every placeholder.
BACKEND_IMAGE=registry.example.com/sassblum-backend:REPLACE_WITH_IMMUTABLE_TAG
FRONTEND_IMAGE=registry.example.com/sassblum-frontend:REPLACE_WITH_IMMUTABLE_TAG
DJANGO_SECRET_KEY=REPLACE_WITH_50_PLUS_RANDOM_CHARACTERS
DATABASE_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@REPLACE_HOST:5432/REPLACE_DB
CORS_ALLOWED_ORIGINS=https://app.example.com
CSRF_TRUSTED_ORIGINS=https://app.example.com
ALLOWED_HOSTS=api.example.com
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=notificaciones@sassblum.com
EMAIL_HOST_PASSWORD=REPLACE_SECRET
DEFAULT_FROM_EMAIL=notificaciones@sassblum.com
FRONTEND_URL=https://app.example.com

# Optional integrations
BREVO_API_KEY=
EMAIL_CC=info@sassblum.com,soporte@sassblum.com
SASSBLUM_CONTACT_PHONE=+593-9-6999-0990,+593-9-9528-6319
SASSBLUM_CONTACT_EMAIL=soporte@sassblum.com
SASSBLUM_CONTACT_HOURS=Horario de atención de la administración
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=sassblum
