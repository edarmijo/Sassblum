# BUG-06: la API se consume vía el rewrite de Vercel (/api/* → Render, ver
# vercel.json). Así frontend y API son el MISMO sitio y la cookie httpOnly del
# refresh token es first-party: la sesión sobrevive a recargas sin depender de
# cookies de terceros (que los navegadores bloquean).
VITE_API_BASE_URL=/api
# El WS sí va directo a Render: los rewrites de Vercel no proxean WebSockets.
# El backend permite este origen vía WS_ALLOWED_ORIGINS (config/settings.py).
VITE_WS_URL=wss://sassblum.onrender.com
VITE_ENV=production
